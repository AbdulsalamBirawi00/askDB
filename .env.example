# Copy to .env (repo root) and fill in. One file serves apps/web and packages/db.
# Never commit .env. In production, set these in the Vercel project settings.

# App database (users, logs, dashboards).
# Local: `pnpm db:up` starts Postgres from docker-compose.yml on port 5433.
# Production: Neon project 1 connection string (with ?sslmode=require).
DATABASE_URL=postgres://askdb:askdb@localhost:5433/askdb

# Auth (Better Auth). Signs session cookies; at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app, e.g. https://askdb-pi.vercel.app. Optional locally
# (the request origin is used); set it in production.
BETTER_AUTH_URL=

# GitHub OAuth app (github.com/settings/developers). Optional: without both,
# only "Try as guest" is offered. Callback URL: <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). At least 16 characters.
# Generate: openssl rand -hex 24
CRON_SECRET=

# Encrypts saved connection URLs (AES-256-GCM). 32 bytes, base64. Required.
# Generate: openssl rand -base64 32. Changing it makes saved connections unreadable.
CONNECTION_ENCRYPTION_KEY=

# true only for local development and CI: lets users connect to localhost/private
# addresses. Leave unset in production (SSRF protection).
ALLOW_PRIVATE_DB_HOSTS=true

# Northwind sample data (pnpm db:northwind): password for the read-only role.
NORTHWIND_READONLY_PASSWORD=

# Language models (free tiers). Optional, but questions need at least one.
# Every configured model is tried in turn when one is rate limited or down.
# SQL: Groq, Gemini, Z.ai, NVIDIA, Gemini lite, Gemma. Summaries: the light models first.
# Groq key: console.groq.com/keys. Gemini key (also used for Gemma): aistudio.google.com/apikey.
# Z.ai key (GLM, free model, no card): z.ai, API keys in the console.
# NVIDIA key (free, no card, starts with nvapi-): build.nvidia.com, "Get API Key".
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b on Groq, gemini-3.5-flash).
GROQ_MODEL=
GOOGLE_MODEL=
# Second Gemini model, tried with the same key when the first is overloaded
# (default gemini-3.5-flash-lite). Set to "none" to turn it off.
GOOGLE_FALLBACK_MODEL=
# Gemma on the same Google key, with its own daily quota (default gemma-4-31b-it).
# Set to "none" to turn it off.
GEMMA_MODEL=
# Z.ai GLM (default model glm-4.5-flash, free).
ZAI_API_KEY=
ZAI_MODEL=
# NVIDIA free API (default model moonshotai/kimi-k3.1-pro).
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Local development only: an Ollama server's OpenAI-compatible endpoint.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
